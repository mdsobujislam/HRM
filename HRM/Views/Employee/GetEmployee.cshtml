@model IEnumerable<HRM.Models.Employee>
@using System.Text.Json

@{
    ViewData["Title"] = "GetEmployee";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-md-12">
        <div class="card shadow">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0">Employee List</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table datanew">
                        <thead class="table-primary">
                            <tr>
                                <th>SL No.</th>
                                <th>Emp ID</th>
                                <th>Photo</th>
                                <th>Emp Name</th>
                                <th>Father Name</th>
                                <th>Mother Name</th>
                                <th>Spouse Name</th>
                                <th>DOB</th>
                                <th>Blood Group</th>
                                <th>Gender</th>
                                <th>Marital Status</th>
                                <th>Tin No</th>
                                <th>National ID</th>
                                <th>Telephone (Resi)</th>
                                <th>Mobile No</th>
                                <th>Mail ID</th>
                                <th>Permanent Address</th>
                                <th>Present Address</th>
                                <th>Posting</th>
                                <th>Department</th>
                                <th>Designation</th>
                                <th>Date of Appointment</th>
                                <th>Religion</th>
                                <th>Nationality</th>
                                <th>Shift</th>
                                <th>Version</th>
                                <th>Job Type</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int index = 0;
                            }
                            @foreach (var item in Model)
                            {
                                index++;
                                var photoPath = string.IsNullOrEmpty(item.UploadPhoto)
                                ? Url.Content("~/profile/default/defaultPic.jpg")
                                : Url.Content("~/profile/" + item.UploadPhoto);

                                <tr>
                                    <td>@index</td>
                                    <td>@item.EmpId</td>
                                    <td><img src="@photoPath" alt="Employee Photo" style="height:80px;width:80px;object-fit:contain;object-position:center;border-radius:4px;" /></td>
                                    <td>@item.EmployeeName</td>
                                    <td>@item.FatherName</td>
                                    <td>@item.MotherName</td>
                                    <td>@item.SpouseName</td>
                                    <td>@item.DOB</td>
                                    <td>@item.BloodGroup</td>
                                    <td>@item.Gender</td>
                                    <td>@item.MaritalStatus</td>
                                    <td>@item.TinNo</td>
                                    <td>@item.NationalID</td>
                                    <td>@item.Telephone</td>
                                    <td>@item.MobileNo</td>
                                    <td>@item.MailID</td>
                                    <td>@item.PermanentAddress</td>
                                    <td>@item.PresentAddress</td>
                                    <td>@item.Branch</td>
                                    <td>@item.Department</td>
                                    <td>@item.Designation</td>
                                    <td>@item.DateOfAppointment.ToString("yyyy-MM-dd")</td>
                                    <td>@item.Religion</td>
                                    <td>@item.Nationality</td>
                                    <td>@item.Shift</td>
                                    <td>@item.Version</td>
                                    <td>@item.JobType</td>
                                    <td class="text-center align-middle">
                                        <div class="d-flex justify-content-center align-items-center gap-2">
                                            <button class="btn btn-warning btn-sm edit-btn"
                                                    data-employee='@Html.Raw(JsonSerializer.Serialize(item))'
                                                    data-bs-toggle="modal" data-bs-target="#addModal">
                                                <i class="fas fa-edit"></i> Edit
                                            </button>

                                            <form asp-action="DeleteEmployee" method="post" class="deleteForm mb-0">
                                                <input type="hidden" name="ID" value="@item.Id" />
                                                <button type="submit" class="btn btn-danger btn-sm">
                                                    <i class="fas fa-trash-alt"></i> Delete
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal -->
<form method="post" asp-action="UpdateEmployee" enctype="multipart/form-data">
    <input type="hidden" name="Id" id="Id" />
    <div class="modal fade" id="addModal" tabindex="-1" aria-labelledby="addModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title" id="addModalLabel">Edit Employee</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <input type="hidden" name="EmpId" id="EmpId" />

                    <div class="row">
                        <div class="col-md-4"><label>Employee Name</label><input type="text" name="EmployeeName" id="EmployeeName" class="form-control" /></div>
                        <div class="col-md-4"><label>Father Name</label><input type="text" name="FatherName" id="FatherName" class="form-control" /></div>
                        <div class="col-md-4"><label>Mother Name</label><input type="text" name="MotherName" id="MotherName" class="form-control" /></div>
                    </div>

                    <div class="row mt-2">
                        <div class="col-md-4"><label>Spouse Name</label><input type="text" name="SpouseName" id="SpouseName" class="form-control" /></div>
                        <div class="col-md-4"><label>Date of Birth</label><input type="date" name="DOB" id="DOB" class="form-control" /></div>
                        <div class="col-md-4"><label>Gender</label><input type="text" name="Gender" id="Gender" class="form-control" /></div>
                    </div>

                    <div class="row mt-2">
                        <div class="col-md-4"><label>Blood Group</label><input type="text" name="BloodGroup" id="BloodGroup" class="form-control" /></div>
                        <div class="col-md-4"><label>Marital Status</label><input type="text" name="MaritalStatus" id="MaritalStatus" class="form-control" /></div>
                        <div class="col-md-4"><label>TIN No</label><input type="text" name="TinNo" id="TinNo" class="form-control" /></div>
                    </div>

                    <div class="row mt-2">
                        <div class="col-md-4"><label>National ID</label><input type="text" name="NationalID" id="NationalID" class="form-control" /></div>
                        <div class="col-md-4"><label>Telephone</label><input type="text" name="Telephone" id="Telephone" class="form-control" /></div>
                        <div class="col-md-4"><label>Mobile No</label><input type="text" name="MobileNo" id="MobileNo" class="form-control" /></div>
                    </div>

                    <div class="row mt-2">
                        <div class="col-md-4"><label>Mail ID</label><input type="text" name="MailID" id="MailID" class="form-control" /></div>
                        <div class="col-md-4"><label>Permanent Address</label><input type="text" name="PermanentAddress" id="PermanentAddress" class="form-control" /></div>
                        <div class="col-md-4"><label>Present Address</label><input type="text" name="PresentAddress" id="PresentAddress" class="form-control" /></div>
                    </div>

                    <div class="row mt-2">
                        <div class="col-md-4"><label>Branch</label><input type="number" name="BranchId" id="BranchId" class="form-control" /></div>
                        <div class="col-md-4"><label>Department</label><input type="number" name="DepartmentId" id="DepartmentId" class="form-control" /></div>
                        <div class="col-md-4"><label>Designation</label><input type="number" name="DesignationId" id="DesignationId" class="form-control" /></div>
                    </div>

                    <div class="row mt-2">
                        <div class="col-md-4"><label>Date of Appointment</label><input type="date" name="DateOfAppointment" id="DateOfAppointment" class="form-control" /></div>
                        <div class="col-md-4"><label>Religion</label><input type="text" name="Religion" id="Religion" class="form-control" /></div>
                        <div class="col-md-4"><label>Nationality</label><input type="text" name="Nationality" id="Nationality" class="form-control" /></div>
                    </div>

                    <div class="row mt-2">
                        <div class="col-md-4"><label>Shift</label><input type="text" name="Shift" id="Shift" class="form-control" /></div>
                        <div class="col-md-4"><label>Version</label><input type="text" name="Version" id="Version" class="form-control" /></div>
                        <div class="col-md-4"><label>Job Type</label><input type="text" name="JobType" id="JobType" class="form-control" /></div>
                    </div>

                    <div class="row mt-2">
                        <div class="col-md-4"><label>Upload New Photo</label><input type="file" name="PhotoFile" class="form-control" /></div>
                        <div class="col-md-4">
                            <label>Existing Photo</label><br />
                            <img id="existingPhoto" src="" class="img-thumbnail mt-2" width="100" />
                        </div>
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">Update</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                </div>

            </div>
        </div>
    </div>
</form>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    // Modal এ ডাটা set করার জন্য কোড
    document.querySelectorAll('.edit-btn').forEach(button => {
        button.addEventListener('click', function () {
            const emp = JSON.parse(this.getAttribute('data-employee'));

            document.getElementById("Id").value = emp.Id;
            document.getElementById("EmpId").value = emp.EmpId;
            document.getElementById("EmployeeName").value = emp.EmployeeName;
            document.getElementById("FatherName").value = emp.FatherName;
            document.getElementById("MotherName").value = emp.MotherName;
            document.getElementById("SpouseName").value = emp.SpouseName;
            document.getElementById("DOB").value = emp.DOB;
            document.getElementById("Gender").value = emp.Gender;
            document.getElementById("BloodGroup").value = emp.BloodGroup;
            document.getElementById("MaritalStatus").value = emp.MaritalStatus;
            document.getElementById("TinNo").value = emp.TinNo;
            document.getElementById("NationalID").value = emp.NationalID;
            document.getElementById("Telephone").value = emp.Telephone;
            document.getElementById("MobileNo").value = emp.MobileNo;
            document.getElementById("MailID").value = emp.MailID;
            document.getElementById("PermanentAddress").value = emp.PermanentAddress;
            document.getElementById("PresentAddress").value = emp.PresentAddress;
            document.getElementById("BranchId").value = emp.BranchId;
            document.getElementById("DepartmentId").value = emp.DepartmentId;
            document.getElementById("DesignationId").value = emp.DesignationId;
            document.getElementById("DateOfAppointment").value = emp.DateOfAppointment ? emp.DateOfAppointment.split('T')[0] : '';
            document.getElementById("Religion").value = emp.Religion;
            document.getElementById("Nationality").value = emp.Nationality;
            document.getElementById("Shift").value = emp.Shift;
            document.getElementById("Version").value = emp.Version;
            document.getElementById("JobType").value = emp.JobType;

            const existingPhoto = document.getElementById("existingPhoto");
            if (emp.UploadPhoto && emp.UploadPhoto !== "null" && emp.UploadPhoto !== "") {
                existingPhoto.src = "/profile/" + emp.UploadPhoto;
            } else {
                existingPhoto.src = "/profile/default/defaultPic.jpg";
            }
        });
    });

    // Delete confirmation
    document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('.deleteForm').forEach(function (form) {
            form.addEventListener('submit', function (e) {
                e.preventDefault();
                Swal.fire({
                    title: 'Are you sure?',
                    text: "This will permanently delete the Employee.",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#3085d6',
                    confirmButtonText: 'Yes, delete it!'
                }).then((result) => {
                    if (result.isConfirmed) {
                        form.submit();
                    }
                });
            });
        });
    });
</script>
